    <script>
        let currentIndex = 0;
        const slides = document.querySelectorAll('.slide-container');
        const totalSlides = slides.length;
        let touchStartX = 0;
        let touchEndX = 0;

        // Initialize progress dots
        const progressContainer = document.getElementById('progressDots');
        for (let i = 0; i < totalSlides; i++) {
            const dot = document.createElement('div');
            dot.className = 'dot' + (i === 0 ? ' active' : '');
            dot.addEventListener('click', () => goToSlide(i));
            progressContainer.appendChild(dot);
        }
        const dots = document.querySelectorAll('.dot');

        function updateSlide(newIndex) {
            slides.forEach((slide, index) => {
                slide.classList.remove('active', 'prev');
                if (index < newIndex) slide.classList.add('prev');
                else if (index === newIndex) slide.classList.add('active');
            });
            dots.forEach((dot, index) => dot.classList.toggle('active', index === newIndex));
            document.getElementById('prevBtn').disabled = newIndex === 0;
            document.getElementById('nextBtn').disabled = newIndex === totalSlides - 1;
            currentIndex = newIndex;
        }

        function goToSlide(index) {
            if (index >= 0 && index < totalSlides) updateSlide(index);
        }

        function nextSlide() { if (currentIndex < totalSlides - 1) updateSlide(currentIndex + 1)); }
        function prevSlide() { if (currentIndex > 0) updateSlide(currentIndex - 1)); }

        document.getElementById('prevBtn').addEventListener('click', prevSlide);
        document.getElementById('nextBtn').addEventListener('click', nextSlide);

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
                e.preventDefault();
                nextSlide();
            } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
                e.preventDefault();
                prevSlide();
            }
        });

        // Touch/Swipe navigation
        const container = document.getElementById('presentation');
        container.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        container.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) nextSlide();
                else prevSlide();
            }
        }, { passive: true });

        // Mouse drag for desktop
        let isDragging = false;
        let startX = 0;
        container.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX; });
        container.addEventListener('mouseup', (e) => {
            if (isDragging) {
                const diff = startX - e.clientX;
                if (Math.abs(diff) > 50) {
                    if (diff > 0) nextSlide();
                    else prevSlide();
                }
            }
            isDragging = false;
        });

        // Initialize
        updateSlide(0);
    </script>
